modules = ["python-3.11", "python3"]

[nix]
channel = "stable-25_05"
packages = ["geckodriver", "glibcLocales", "libxcrypt", "pkg-config", "xcodebuild", "xsimd", "zlib"]

[deployment]
deploymentTarget = "autoscale"
run = ["streamlit", "run", "app.py", "--server.port", "5000"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Options Trading Platform"

[[workflows.workflow]]
name = "Options Trading Platform"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app_test.py --server.port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 42587
externalPort = 3000

[agent]
integrations = ["python_slack==1.0.0", "perplexity_v0==1.0.0", "python_openai==1.0.0", "python_notion==1.0.0", "web_scraper==1.0.0"]
